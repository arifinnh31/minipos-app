# ==============================================================================
# MINIPOS APPLICATION - ENVIRONMENT VARIABLES TEMPLATE (.env.example)
# ==============================================================================
# Salin format ini saat melakukan konfigurasi Environment Variables di Vercel.
# ==============================================================================

# 1. DATABASE CONNECTION (SUPABASE POSTGRESQL & PRISMA ORM)
# Mode Transaction Pooler (PgBouncer - Port 6543) untuk query runtime
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Mode Session / Direct Connection (Port 5432) untuk migrasi & prisma generate
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# 2. SUPABASE API AUTHENTICATION & SSR
NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT-REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.YOUR_ANON_KEY_HERE"
